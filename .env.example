# ─────────────────────────────────────────────────────────────
# Swad MH13 — server-side environment variables
# These are read ONLY by the Express server (server/).
# They are never bundled into the browser build.
# Add the real values in AppJet: Settings -> Environment variables.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# A bare project ref also works: SUPABASE_URL=vppfluhgfkbamwngadcd
SUPABASE_URL=

# Alternative to SUPABASE_URL — the bare project ref from your dashboard URL
# (https://supabase.com/dashboard/project/<ref>). Only used when SUPABASE_URL is empty.
SUPABASE_PROJECT_REF=

# Supabase secret key (starts with sb_secret_). Modern replacement for the
# service_role key: full database access, so it must stay server-side only.
SUPABASE_SECRET_KEY=

# Legacy name for the same thing (still supported).
SUPABASE_SERVICE_ROLE_KEY=

# Publishable key (starts with sb_publishable_) or the legacy anon key.
# Enough for normal reads/writes when your RLS policies allow them.
SUPABASE_ANON_KEY=

SUPABASE_PUBLISHABLE_KEY=

# Optional: port the Express server listens on (default 3000)
PORT=3000
